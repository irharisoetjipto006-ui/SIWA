<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>SIWA - Hari Ini</title>

<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html,body{

    height:100%;

    overflow:hidden;

    font-family:Arial,Helvetica,sans-serif;

    background:#edf4ed;

}

body{

    display:flex;

    flex-direction:column;

}

/* ================= HEADER ================= */

header{

    background:#2e7d32;

    color:white;

    padding:12px 25px;

}

header h1{

    font-size:32px;

}

header p{

    font-size:16px;

    margin-top:3px;

}

/* ================= CONTENT ================= */

main{

    flex:1;

    padding:20px;

    display:flex;

    flex-direction:column;

}

.info{

    background:white;

    border-radius:12px;

    padding:15px 20px;

    box-shadow:0 2px 6px rgba(0,0,0,.1);

}

.info h2{

    font-size:30px;

}

.info p{

    margin-top:8px;

    font-size:18px;

}

/* ================= BUTTON FKKP ================= */

.mainButton{

    margin-top:18px;

    background:#43a047;

    color:white;

    text-decoration:none;

    text-align:center;

    border-radius:15px;

    padding:18px;

    font-size:34px;

    font-weight:bold;

}

/* ================= MENU ================= */

.grid{

    flex:1;

    margin-top:18px;

    display:grid;

    grid-template-columns:repeat(3,1fr);

    grid-template-rows:repeat(2,1fr);

    gap:15px;

}

.card{

    background:white;

    border-radius:12px;

    display:flex;

    justify-content:center;

    align-items:center;

    text-align:center;

    font-size:24px;

    box-shadow:0 2px 8px rgba(0,0,0,.1);

}

/* ================= FOOTER ================= */

footer{

    text-align:center;

    padding:12px;

    color:#666;

    font-size:18px;

}

</style>

</head>

<body>

<header>

<h1>🌱 SIWA</h1>

<p>Pertumbuhan Hayat — Hari Ini</p>

</header>

<main>

<div class="info">

<h2>Kamis, 9 Juli 2026</h2>

<p>FKKP : Minggu 2 • Hari 4</p>

<p>Tema : Ministri Rekonsiliasi</p>

</div>

<a href="#" class="mainButton">

📖 BACA FKKP

</a>

<div class="grid">

<div class="card">📚<br>Alkitab</div>

<div class="card">💬<br>Dialog AI</div>

<div class="card">🎧<br>Audio</div>

<div class="card">📝<br>Jurnal</div>

<div class="card">🎤<br>SPR</div>

<div class="card">🤝<br>Kehidupan Gereja</div>

</div>

</main>

<footer>

"Makan Firman hari ini untuk hidup hari ini."

</footer>

</body>
</html>