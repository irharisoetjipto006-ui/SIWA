<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>FKKP</title>

<style>

body{
    font-family:Arial,Helvetica,sans-serif;
    background:#f4f4f4;
    margin:40px;
}

.card{
    max-width:900px;
    margin:auto;
    background:white;
    padding:30px;
    border-radius:10px;
    box-shadow:0 0 10px #ccc;
}

h1{
    color:#1c5d99;
}

h2{
    color:#2b9348;
}

textarea{
    width:100%;
    height:180px;
    font-size:16px;
    margin-top:10px;
}

.button{
    display:inline-block;
    margin-top:20px;
    padding:10px 20px;
    background:#1c5d99;
    color:white;
    text-decoration:none;
    border-radius:5px;
}

</style>

</head>

<body>

<div class="card">

<h1><%= book %></h1>

<p><b><%= author %></b></p>

<hr>

<h2>Minggu <%= week %> — Hari <%= day %></h2>

<h3><%= title %></h3>

<hr>

<h3>📖 Ayat Hari Ini</h3>

<p>(Belum diisi)</p>

<hr>

<h3>🌱 Makan Firman</h3>

<textarea placeholder="Catatan makan Firman..."></textarea>

<hr>

<h3>✨ Rhema Saya</h3>

<textarea placeholder="Apa yang Tuhan terangkan hari ini..."></textarea>

<br>

<a href="/dashboard" class="button">
← Dashboard
</a>

</div>

</body>
</html>