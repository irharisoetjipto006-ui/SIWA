#!/bin/bash
SIWA_HOME="$HOME/SIWA"

show_help() {
echo ""
echo "======================================="
echo "            SIWA CLI"
echo "======================================="
echo ""
echo " build      Build / upgrade SIWA"
echo " start      Jalankan server"
echo " stop       Hentikan server"
echo " push       Git add + commit + push"
echo " import     Import data (whatsapp)"
echo " doctor     Diagnosa SIWA"
echo " version    Informasi SIWA"
echo " help       Bantuan"
echo ""
}

case "$1" in
build) exec "$SIWA_HOME/tools/build.sh" ;;
start) exec "$SIWA_HOME/tools/start.sh" ;;
stop) exec "$SIWA_HOME/tools/stop.sh" ;;
doctor) exec "$SIWA_HOME/tools/doctor.sh" ;;
push|update) exec "$SIWA_HOME/tools/update.sh" "${@:2}" ;;
import)
    if [ "$2" = "whatsapp" ]; then
        exec "$SIWA_HOME/import/whatsapp.sh"
    else
        echo "Opsi import tidak dikenal: $2"
        echo "Gunakan: siwa import whatsapp"
        exit 1
    fi
    ;;
version) echo "SIWA"; git -C "$SIWA_HOME" rev-parse --short HEAD ;;
help|"") show_help ;;
*) echo "Perintah tidak dikenal : $1"; echo ""; show_help; exit 1 ;;
esac
